# ============================================================================
# PawType-16 — environment variables
# Copy to `.env.local` for local dev, or set in Vercel Project Settings.
# ============================================================================

# ---- Public site URL (used for OG image absolute paths + sitemap) ----------
# Local dev: http://localhost:3000
# Production: https://your-domain.com (NO trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Supabase (OPTIONAL — leave blank for in-memory demo mode) -------------
# Get from https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Keep secret. Used by future admin write operations.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Admin Basic Auth (gates /{locale}/admin) ------------------------------
# REQUIRED for /admin to work. v4 fails-closed if these are missing or weak.
# Rules: ADMIN_PASS must be ≥8 chars and NOT "changeme" / "admin"
ADMIN_USER=admin
ADMIN_PASS=please-set-a-strong-password
